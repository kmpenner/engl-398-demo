  <text>
    <body>
      <div type="letter" xml:id="div_letter" xml:lang="fr">
        <pb n="f.1r" facs="#f1r"/>
        <div>
          <p>
            <choice><orig>a</orig><reg resp="#editor">à</reg></choice>
            l'<orgName ref="wikidata:Q780457"><choice><orig>Assemblee</orig><reg resp="#editor">Assemblée</reg></choice> Nationale</orgName>
            <gap reason="damage" unit="chars" extent="20"/>
            <date when="1791-12-31">31 <choice><abbr type="suspension">x<hi rend="superscript">bre</hi></abbr><expan resp="#editor">décembre</expan></choice> 1791</date>.
            <gap reason="damage" unit="chars" extent="15"/>
            1
          </p>
        </div>
        <div>
          <p>
            J'ai chargé <persName ref="wikidata:Q2976897">le Ministre des affaires <choice><orig>etrangeres</orig><reg resp="#editor">étrangères</reg></choice></persName>,
            <choice>
              <abbr type="title">MM.</abbr>
              <expan resp="#editor">Messieurs</expan>
            </choice>
            de vous communiquer<lb/>
            l'office que <persName ref="wikidata:Q151321">l'Empereur</persName> a fait remettre
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            <persName ref="wikidata:Q3052789">l'Ambassadeur de France</persName> <choice><orig>a</orig><reg resp="#editor">à</reg></choice><lb/>
            <placeName ref="geonames:2761369">Vienne</placeName>.
            <choice>
              <orig>cet</orig>
              <reg resp="#editor">Cet</reg>
            </choice>
            office, je dois le dire, m'a causé le plus grand
            <choice>
              <orig>etonnement</orig>
              <reg resp="#editor">étonnement</reg>
            </choice>.<lb/>
            <choice>
              <orig>J'avois</orig>
              <reg resp="#editor">J'avais</reg>
            </choice>
            droit
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            compter sur les
            <choice>
              <orig>sentimens</orig>
              <reg resp="#editor">sentiments</reg>
            </choice>
            de <persName ref="wikidata:Q151321">l'Empereur</persName> et sur son<lb/>
            <choice>
              <orig>desir</orig>
              <reg resp="#editor">désir</reg>
            </choice>
            de conserver avec la <placeName ref="geonames:3017382">France</placeName> la bonne intelligence et tous les<lb/>
            rapports, qui doivent
            <choice>
              <orig>regner</orig>
              <reg resp="#editor">régner</reg>
            </choice>
            entre deux alliés.
            <choice>
              <orig>je</orig>
              <reg resp="#editor">Je</reg>
            </choice>
            ne peux pas<lb/>
            croire encore que ses dispositions soient changées, j'aime
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            me<lb/>
            persuader qu'il a
            <choice>
              <orig>eté</orig>
              <reg resp="#editor">été</reg>
            </choice>
            trompé sur la
            <choice>
              <orig>verité</orig>
              <reg resp="#editor">vérité</reg>
            </choice>
            des faits, qu'il a<lb/>
            cru que <persName ref="wikidata:Q565780">l'Electeur de <choice><orig>Treves</orig><reg resp="#editor">Trèves</reg></choice></persName>
            <choice>
              <orig>avoit</orig>
              <reg resp="#editor">avait</reg>
            </choice>
            satisfait aux devoirs de la<lb/>
            justice et du bon voisinage, et que
            <choice>
              <orig>neantmoins</orig>
              <reg resp="#editor">néanmoins</reg>
            </choice>
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            droit
            <choice>
              <orig>avoit</orig>
              <reg resp="#editor">avait</reg>
            </choice>
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice><lb/>
            craindre que ses <placeName ref="wikidata:Q1794352"><choice><orig>etats</orig><reg resp="#editor">états</reg></choice></placeName>
            ne fussent exposés
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            des violences ou
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            des<lb/>
            incursions
            <choice>
              <orig>particulieres</orig>
              <reg resp="#editor">particulières</reg>
            </choice>.
          </p>
          <p>
            Dans la
            <choice>
              <orig>reponse</orig>
              <reg resp="#editor">réponse</reg>
            </choice>
            que je
            <choice>
              <sic>faits</sic>
              <corr resp="#editor">fais</corr>
            </choice>
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            <persName ref="wikidata:Q151321">l'Empereur</persName>, je lui
            <choice>
              <orig>repette</orig>
              <reg resp="#editor">répète</reg>
            </choice>
            que je n'ai<lb/>
            rien demandé que de juste
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            <persName ref="wikidata:Q565780">l'Electeur de <choice><orig>Treves</orig><reg resp="#editor">Trèves</reg></choice></persName>,
            rien dont<lb/>
            <persName ref="wikidata:Q151321">l'Empereur</persName> n'ait lui
            <choice>
              <orig>mesme</orig>
              <reg resp="#editor">même</reg>
            </choice>
            donné l'exemple.
            <choice>
              <orig>je</orig>
              <reg resp="#editor">Je</reg>
            </choice>
            lui rappelle le<lb/>
            soin que la Nation
            <choice>
              <orig>Françoise</orig>
              <reg resp="#editor">Française</reg>
            </choice>
            a prise de
            <choice>
              <orig>prevenir</orig>
              <reg resp="#editor">prévenir</reg>
            </choice>
            sur le champ<lb/>
            les
            <choice>
              <orig>rassemblemens</orig>
              <reg resp="#editor">rassemblements</reg>
            </choice>
            de Brabançons qui
            <choice>
              <orig>paroissent</orig>
              <reg resp="#editor">paraissent</reg>
            </choice>
            vouloir se former<lb/>
            dans le voisinage des <placeName ref="wikidata:Q700283"><choice><orig>Pays Bas</orig><reg resp="#editor">Pays-Bas</reg></choice> autrichiens</placeName>. Enfin je lui renouvelle<lb/>
            le
            <choice>
              <orig>voeu</orig>
              <reg resp="#editor">vœu</reg>
            </choice>
            de la
            <choice>
              <orig>france</orig>
              <reg resp="#editor">France</reg>
            </choice>
            pour la conservation de la paix.
            <choice>
              <orig>mais</orig>
              <reg resp="#editor">Mais</reg>
            </choice>
            en<lb/>
            <choice>
              <orig>mesme</orig>
              <reg resp="#editor">même</reg>
            </choice>
            temps je lui
            <choice>
              <orig>declare</orig>
              <reg resp="#editor">déclare</reg>
            </choice>
            que si
            <choice>
              <orig>a</orig>
              <reg resp="#editor">à</reg>
            </choice>
            <choice>
              <orig>l'epoque</orig>
              <reg resp="#editor">l'époque</reg>
            </choice>
            que j'ai fixée<lb/>
            <persName ref="wikidata:Q565780">l'Electeur de <choice><orig>Treves</orig><reg resp="#editor">Trèves</reg></choice></persName>
            n'a pas effectivement et
            <choice>
              <orig>reellement</orig>
              <reg resp="#editor">réellement</reg>
            </choice>
            dissipé<lb/>
            les
            <choice>
              <orig>rassemblemens</orig>
              <reg resp="#editor">rassemblements</reg>
            </choice>
            qui existent dans ses <placeName ref="wikidata:Q1794352"><choice><orig>Etats</orig><reg resp="#editor">États</reg></choice></placeName>,
            rien ne
            <choice>
              <orig>m'empechera</orig>
              <reg resp="#editor">m'empêchera</reg>
            </choice>
          </p>
        </div>
      </div>
    </body>
